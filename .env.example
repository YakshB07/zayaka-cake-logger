# TIMEZONE for reminders (default America/Toronto)
# TIMEZONE=America/Toronto

# Numbers that receive the cake reminders (comma-separated).
# Defaults to the two bakery phones if not set.
# REMINDER_PHONES=+12269610140,+12269610150

# ── Database (Supabase Postgres) ──
# Without this, orders are saved to a local file — fine for testing on your
# own computer, but wiped on free hosting. Set this in production.
# Get it from Supabase → Project Settings → Database → Connection string (URI).
# DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres

# ── Photo storage (Supabase Storage) ──
# Without these, uploaded cake photos are saved to a local folder — same
# caveat as above. Get them from Supabase → Project Settings → API.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=cake-photos

# ── Cron endpoint secret ──
# Protects /api/cron/reminders (hit by the GitHub Actions workflow) so
# strangers can't trigger reminder texts. Any random string works.
# CRON_SECRET=

# ── Twilio (needed for real SMS texts) ──
# 1. Sign up at https://www.twilio.com (free trial works)
# 2. Buy/claim a phone number, then copy these three values from the Twilio console:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
